<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#080808">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ULTRON"
        android:textColor="#FF2A2A"
        android:textStyle="bold"
        android:textSize="38sp"
        android:layout_marginTop="42dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wake phrase: Hey ULTRON"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/aliasName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alias name (e.g. Akka)"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginTop="36dp"/>

    <EditText
        android:id="@+id/aliasNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone number"
        android:inputType="phone"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"/>

    <Button
        android:id="@+id/saveAlias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save call alias"/>

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start ULTRON"
        android:layout_marginTop="18dp"/>

    <Button
        android:id="@+id/accessibilityBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Chennai One automation"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Examples:\n• Hey ULTRON → சொல்லுங்க பாஸ்\n• Akka-ku call pannu\n• T Nagar-ku route podu\n• WhatsApp open pannu\n• Top five technology news\n• Velachery to T Nagar ticket book pannu"
        android:textColor="#CCCCCC"
        android:textSize="15sp"
        android:layout_marginTop="24dp"/>
</LinearLayout>
